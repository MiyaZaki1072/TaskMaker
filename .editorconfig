# Shared editor settings — most editors pick this up automatically (VS Code needs the
# "EditorConfig for VS Code" extension). https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown uses two trailing spaces as a line break.
[*.md]
trim_trailing_whitespace = false

# Fixtures and snapshots are compared byte-for-byte by the tests — never reformat them.
[test/fixtures/**]
trim_trailing_whitespace = false
insert_final_newline = unset
