# Copy to .env next to docker-compose.yml, fill in the two passwords, then:
#   docker compose up -d --build
#
# .env is gitignored — it never goes into the repo or the image.

# ---- required ----

# The password you type on the studio's login page.
# Generate one you will not guess:  openssl rand -base64 24
STUDIO_PASSWORD=

# The Postgres password. Nothing outside the Docker network can reach the database, but this is
# still what protects it from another container on the same box.
#
# Hex, not base64, and that matters: docker-compose.yml builds DATABASE_URL by pasting this into
# postgres://studio:<password>@db:5432/studio. base64 output contains "/" and "+", which end the
# userinfo part of a URL early — the app then fails to connect with an error that blames the host
# rather than the password.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- optional ----

# Postgres user / database name. Change only if you have a reason to.
# POSTGRES_USER=studio
# POSTGRES_DB=studio

# Your public URL. Set this: it is what lets the app reject form posts coming from another site.
# PUBLIC_ORIGIN=https://studio.rywcc.org

# Where to publish the studio's port on the box.
# 0.0.0.0 (default) means the LAN can reach it too; 127.0.0.1 restricts it to the box itself,
# which works only if cloudflared also runs on the host rather than in its own container.
# STUDIO_BIND=0.0.0.0
# STUDIO_PORT=4322

# Set to 0 only if you open the studio over plain http:// (a LAN address, no tunnel). A Secure
# cookie is dropped by the browser on a non-HTTPS page, which looks exactly like "login does
# nothing". Behind the Cloudflare tunnel, leave it at 1.
# SECURE_COOKIES=1

# Number of proxy hops in front of the app. 1 = cloudflared only (the default and almost always
# right). Raise it only if you added another proxy behind the tunnel.
# TRUST_PROXY=1

# Session signing key. Leave unset: the app generates one on first boot and stores it in Postgres,
# so sessions survive restarts. Set it only if you want to invalidate every session on demand
# (change the value, restart) or run more than one copy of the app against one database.
#   openssl rand -hex 32
# SESSION_SECRET=

# How long a login lasts before it has to be typed again. Default 30 days.
# SESSION_TTL_HOURS=720
