{{!--
  หน้าตาของโจทย์ — ใช้ไฟล์นี้ไฟล์เดียวทั้งตอน preview และตอน export PDF
  ปกติคนเขียนโจทย์ไม่ต้องแตะไฟล์นี้ ถ้าจะปรับหน้าตาให้แก้ assets/style.css ก่อน
--}}<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{code}}</title>
<link rel="stylesheet" href="/vendor/katex/katex.min.css">
<link rel="stylesheet" href="/vendor/hljs/github.min.css">
<link rel="stylesheet" href="/assets/style.css">
</head>
<body>
{{#if warnings.length}}
<aside class="warning-box" role="status">
  <strong>คำเตือน (ไฟล์ PDF จะไม่มีกล่องนี้)</strong>
  <ul>
    {{#each warnings}}<li>{{this}}</li>{{/each}}
  </ul>
</aside>
{{/if}}

<article class="paper">

  <header class="task-head">
    {{#if logoUrl}}<img class="task-logo" src="{{logoUrl}}" alt="โลโก้">{{/if}}
    <div class="task-head-text">
      <div class="task-code">{{{codeHtml}}}</div>
      <h1 class="task-name">{{{nameHtml}}}</h1>
      {{#if author}}<div class="task-author">ผู้ออกโจทย์: {{author}}</div>{{/if}}
    </div>
    <div class="task-limits">
      <span class="limit-label">เวลา</span><span>{{{limits.time}}}</span>
      <span class="limit-label">หน่วยความจำ</span><span>{{{limits.memory}}}</span>
    </div>
  </header>

  <section class="section section-story">
    {{{storyHtml}}}
  </section>

  <section class="section">
    <h2>ข้อมูลนำเข้า</h2>
    <ul class="spec-list">
      {{#each inputFormat}}<li>{{{this}}}</li>{{/each}}
    </ul>
  </section>

  <section class="section">
    <h2>ข้อมูลส่งออก</h2>
    <ul class="spec-list">
      {{#each outputFormat}}<li>{{{this}}}</li>{{/each}}
    </ul>
  </section>

  <section class="section">
    <h2>เงื่อนไข</h2>
    <ul class="spec-list">
      {{#each constraints}}<li>{{{this}}}</li>{{/each}}
    </ul>
  </section>

  {{#if hasSubtasks}}
  <section class="section section-subtasks">
    <h2>ปัญหาย่อย</h2>
    <table class="subtask-table">
      <thead>
        <tr>
          <th class="col-no">ข้อย่อยที่</th>
          <th class="col-score">คะแนน</th>
          <th class="col-cond">เงื่อนไขเพิ่มเติม</th>
        </tr>
      </thead>
      <tbody>
        {{#each subtasks}}
        <tr>
          <td class="col-no">{{index}}</td>
          <td class="col-score">{{score}}</td>
          <td class="col-cond">{{{conditionHtml}}}</td>
        </tr>
        {{/each}}
      </tbody>
      <tfoot>
        <tr>
          <td class="col-no"></td>
          <td class="col-score">{{totalScore}}</td>
          <td class="col-cond">คะแนนรวม</td>
        </tr>
      </tfoot>
    </table>
  </section>
  {{/if}}

  <section class="section section-examples">
    <h2>ตัวอย่าง</h2>
    {{#each examples}}
    <div class="example">
      <h3>ตัวอย่างที่ {{index}}</h3>
      <table class="example-table">
        <thead>
          <tr>
            <th>ข้อมูลนำเข้า</th>
            <th>ข้อมูลส่งออก</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><pre class="io">{{{input}}}</pre></td>
            <td><pre class="io">{{{output}}}</pre></td>
          </tr>
        </tbody>
      </table>
      {{#if imageUrl}}
      <figure class="example-figure">
        <img src="{{imageUrl}}" alt="ภาพประกอบตัวอย่างที่ {{index}}">
      </figure>
      {{/if}}
      {{#if explanationHtml}}
      <div class="example-explanation">
        <h4>คำอธิบาย</h4>
        {{{explanationHtml}}}
      </div>
      {{/if}}
    </div>
    {{/each}}
  </section>

  <section class="section section-limits">
    <h2>ข้อจำกัด</h2>
    <table class="limit-table">
      <tbody>
        <tr><th>เวลาที่ใช้ในการทำงาน</th><td>{{{limits.time}}}</td></tr>
        <tr><th>หน่วยความจำที่ใช้ได้</th><td>{{{limits.memory}}}</td></tr>
      </tbody>
    </table>
  </section>

</article>

<script>
// บอกตัว export PDF ว่า "ฟอนต์และรูปโหลดครบแล้ว" เพื่อไม่ต้องเดาเวลารอ
(async () => {
  try { await document.fonts.ready; } catch (err) { /* เบราว์เซอร์เก่าไม่มี document.fonts */ }
  const pending = Array.from(document.images)
    .filter((img) => !img.complete)
    .map((img) => new Promise((resolve) => {
      img.addEventListener('load', resolve, { once: true });
      img.addEventListener('error', resolve, { once: true });
    }));
  await Promise.all(pending);
  document.documentElement.setAttribute('data-render-ready', '1');
})();
</script>
{{#if live}}<script src="/__live-reload.js"></script>{{/if}}
</body>
</html>
